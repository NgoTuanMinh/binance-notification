# Telegram Bot Configuration
# Lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID để nhận thông báo volume spikes
# Có thể lấy bằng cách gửi tin nhắn cho bot và truy cập: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_NOTIFICATION_CHAT_ID=your_notification_chat_id_here

# Chat ID cho Telegram Bot (có thể khác với notification chat)
TELEGRAM_BOT_CHAT_ID=your_bot_chat_id_here

# Gemini AI API Key
# Lấy từ https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3010

# Binance API Configuration
BINANCE_API_BASE_URL=https://api.binance.com

# Volume Monitor Configuration (có thể thay đổi trong volumeMonitorConfig.js)
# COIN_RANK_MIN=20
# COIN_RANK_MAX=100
# TIME_FRAME=15m
# VOLUME_SPIKE_MULTIPLIER=10
# CACHE_DURATION_HOURS=4
# SCHEDULER_INTERVAL_MINUTES=15
